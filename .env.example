# Eco-City Pulse — environment template (SEC-2).
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value below has a working default in docker-compose.yml, so the stack
# runs with no .env at all — in demo mode, with no network (DR-1 / AC-2).

# --- Application ---
APP_ENV=development
DEBUG=false

# --- Ports (host side) ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
# Host port the *containerised* database is published on. Defaults to 5433 so
# it does not collide with a PostgreSQL already installed on the machine.
POSTGRES_HOST_PORT=5433

# --- CORS (SEC-3) ---
# Comma-separated allowlist. Never use "*".
# 8080 = Nginx container, 5173 = Vite dev server.
FRONTEND_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Database ---
# Two ways to run:
#
#   1. docker compose  -- the db container is created with the credentials
#      below, and the backend reaches it at host "db" on 5432 (compose sets
#      POSTGRES_HOST/POSTGRES_PORT itself, so the values here are ignored
#      for the containerised backend).
#
#   2. local uvicorn   -- point POSTGRES_HOST/POSTGRES_PORT at a PostgreSQL
#      already running on the machine, e.g. localhost:5432.
#
# NOTE: spatial features (district GeoJSON joins, map layers) require the
# PostGIS extension. The postgis/postgis image used by compose has it; a
# stock local PostgreSQL install usually does not.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ecocitypulse
POSTGRES_USER=ecocity
POSTGRES_PASSWORD=changeme

# --- Ingestion mode: scheduled | manual | upload | demo ---
# "demo" needs no network and no API keys.
INGESTION_MODE=demo

# --- Container startup (backend/entrypoint.sh) ---
# Migrations run on boot; the demo dataset is seeded only in demo mode and
# only when the observations table is empty.
RUN_MIGRATIONS=true
AUTO_SEED_DEMO=true
DEMO_SEED_DAYS=120

# Echo every SQL statement. Separate from DEBUG because it is extremely
# verbose during a bulk load.
DB_ECHO=false

# --- Upstream API keys (all optional) ---
# Leave blank to run fully offline. A missing key degrades that source to
# "offline" in data_sources; it never fails a request.
AQICN_API_KEY=
OPENWEATHER_API_KEY=
TOMTOM_API_KEY=
